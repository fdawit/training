  "rules": [
    {"id":"rpe","title":"RPE scale","text":"6 = four reps left · 7 = three · 8 = two · 9 = one · 10 = none. The cap overrides the calculated weight: if the number exceeds the cap, use less."},
    {"id":"sprints","title":"Sprint reps","text":"One rep = one long side of the field. Run at ~85%, controlled—these are tempo repeats, not time trials. Jog the short sides. Capped at 12 while in a deficit."},
    {"id":"bounds","title":"Ski bounds","text":"Contacts shown are per set, both legs. Always before the intervals, never after."},
    {"id":"field-gap","title":"Two-week field rule","text":"More than 14 days since the last field session means drills and build-ups only. Earn the bounds and intervals back over two sessions."},
    {"id":"jefferson","title":"Jefferson curl","text":"Tuesday, Thursday, and after the Field Hour—never before a lifting session, and never within 2 hours of waking. Standalone days need a 5-minute warm-up first."},
    {"id":"jefferson-progression","title":"Jefferson progression","text":"Add load only when the previous weight moves through full range with no hesitation. Range or control regressing means hold or drop."},
    {"id":"bulgarian","title":"Bulgarian split squat","text":"Bodyweight only Weeks 1–2. Light dumbbells Weeks 3–5. Progress normally from Week 6."},
    {"id":"accessories","title":"Accessories","text":"Leave 3+ reps in reserve in Phase 1, 2 in Phase 2, 1–2 in Phase 3. Add load only after hitting the top of the rep range on every set."},
    {"id":"primers","title":"Primers","text":"Load stays light all 15 weeks. If they feel like working sets, they are too heavy."},
    {"id":"big-three","title":"Big Three & Mobility","text":"Unchanged from Week 1. If a 10-second hold cannot be held with quality, shorten to 8 seconds and build back."},
    {"id":"deload","title":"Deload weeks","text":"Cut sets ~40%, hold the prescribed load. Mobility and Big Three continue as normal."}
  ],
  "missedRules": [
    {"id":"session","title":"Miss one session","text":"Skip it. Continue on schedule. Never double up."},
    {"id":"week","title":"Miss one week","text":"Repeat the previous week's loads, then continue."},
    {"id":"two-three","title":"Miss 2–3 weeks","text":"Return to the first week of the current phase."},
    {"id":"four-plus","title":"Miss 4+ weeks","text":"Restart at Phase 1, Week 2."},
    {"id":"compressed","title":"Compressed week","text":"Minimum session: one squat, one hinge, one push, one pull at normal working loads. About 25 minutes."},
    {"id":"vacation","title":"Vacation","text":"Nothing required. Two weeks off costs almost nothing—but the two-week field rule applies on return."}
  ]
}
